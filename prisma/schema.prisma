// ─────────────────────────────────────────────
// FABRIC RECIPE LIBRARY
// ─────────────────────────────────────────────

// ─────────────────────────────────────────────
// RECIPE BENCH TEST
// Lab entries from the FUZE internal lab — raw measurements from
// bench tests + auto-calculated dilution recipes for each of the
// four FUZE tiers. Once a bench test is validated it can graduate
// into a published FabricRecipe.
// ─────────────────────────────────────────────
model RecipeBenchTest {
  id              String   @id @default(cuid())
  testNumber      String   @unique  // FUZE-BT-YYYYMMDD-XXXX
  testDate        DateTime @default(now())

  // What was tested
  fabricId        String?
  fabric          Fabric?  @relation("FabricRecipeBenchTests", fields: [fabricId], references: [id])
  fabricLabel     String   // free-text label if no Fabric linked
  fabricType      String?  // "Knit" | "Woven" | "Nonwoven"
  fiberContent    String?  // "100% Cotton", "65/35 Poly-Cotton"
  fabricWeightGsm Float?

  // Method
  applicationMethod String  // "PAD_DRY_CURE" | "EXHAUST" | "SPRAY" | "FOAM"
  squeezePressure   Float?  // bar or psi (pad)
  vfdFrequencyHz    Float?  // VFD output frequency — FUZE mini pad: m/min ≈ Hz × 0.295
  lineSpeedMPerMin  Float?  // computed feed speed
  dryingTemp        Float?  // °C
  dryingTime        Float?  // minutes
  curingTemp        Float?  // °C
  curingTime        Float?  // minutes
  liquorRatio       String? // "1:10" for exhaust

  // Raw measurements (grams) — primary values are the mean across sample runs
  sampleAreaCm2         Float?  // area of the cut sample (default 100 cm² with FUZE cutter)
  sampleRuns            Json?   // [{run:1, dry, wet, preWet?, wetFromPreWet?}, ...]  for triplicate
  drySampleWeight       Float   // dry fabric before any wetting
  wetAfterBathWeight    Float   // dry-to-wet pad: dry → bath → pad → weigh
  preWetSampleWeight    Float?  // wet-to-wet pad: pre-wet the fabric first
  wetAfterBathFromPreWet Float? // then dip in bath & pad, weigh

  // Calculated outputs (dry-to-wet)
  pickupDryToWetPct     Float?  // %
  // Calculated outputs (wet-to-wet, optional)
  pickupWetToWetPct     Float?  // %
  preWetMoisturePct     Float?  // % of dry

  // For each tier, bath concentration needed (dry-to-wet basis):
  // bath_mg_per_L = (tier_mg_per_kg) / (pickupDryToWetPct / 100 / 1000) → simpler: divide active goal by pickup fraction
  // Then dilution ratio = 30 / bath_mg_per_L (since stock is 30 mg/L)
  f1BathMgPerL          Float?
  f2BathMgPerL          Float?
  f3BathMgPerL          Float?
  f4BathMgPerL          Float?
  f1DilutionRatio       Float?  // parts water per 1 part FUZE stock
  f2DilutionRatio       Float?
  f3DilutionRatio       Float?
  f4DilutionRatio       Float?
  f1FuzeMlPerLBath      Float?  // mL FUZE per L of final bath
  f2FuzeMlPerLBath      Float?
  f3FuzeMlPerLBath      Float?
  f4FuzeMlPerLBath      Float?

  // Production scaling (optional)
  targetProductionKg    Float?  // kg of fabric planned for a production run
  f1FuzeLitersForTarget Float?
  f2FuzeLitersForTarget Float?
  f3FuzeLitersForTarget Float?
  f4FuzeLitersForTarget Float?
  targetBathVolumeL     Float?  // total bath volume needed for production (L)

  // Stock concentration reference (should be 30 mg/L, but snapshot in case it changes)
  stockMgPerL           Float   @default(30)

  // Test bath actually prepared + tier applied for ICP validation
  testedAtTier          String?   // "F1" | "F2" | "F3" | "F4"
  testBathVolumeL       Float?    // 0.5 or 1.0 typical
  testBathFuzeMl        Float?    // mL of FUZE stock added to bath
  testBathWaterMl       Float?    // mL of water to reach the target volume

  // ICP validation — sample sent to lab, result entered when received
  icpLab                String?     // ITS, VL, FPC, etc
  icpSampleId           String?     // lab's tracking number
  icpSubmittedAt        DateTime?
  icpSubmittedById      String?
  icpExpectedPpm        Float?      // expected Ag ppm on fabric (from recipe target)
  icpMeasuredPpm        Float?      // actual ICP result
  icpResultReceivedAt   DateTime?
  icpReportUrl          String?     // uploaded PDF link
  icpNotes              String?
  affinityPct           Float?      // measured / expected × 100  (100% = perfect)

  // Graduation into a published recipe
  graduatedRecipeId     String?
  qcPassed              Boolean @default(true)
  notes                 String?

  createdById           String?

  // Sample applications that used this bench test as their source recipe
  sampleApplications    SampleApplication[] @relation("BenchTestSampleApplications")

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([fabricId])
  @@index([applicationMethod])
  @@index([testDate])
}

// ─────────────────────────────────────────────
// SAMPLE APPLICATION
// The physical act of padding a fabric sample through the FUZE
// vertical micro-padder, then drying it in the dryer chamber
// before it ships to CTLA for ICP. Pulls its recipe (pickup %,
// per-tier dilution, padder settings) straight from a validated
// RecipeBenchTest so there's zero re-derivation in the lab — the
// operator just confirms the bath on-screen and presses pad/dry.
// One SampleApplication → ≥ 0 ICP submission lines.
// ─────────────────────────────────────────────
model SampleApplication {
  id               String   @id @default(cuid())
  appNumber        String   @unique   // FUZE-APP-YYYYMMDD-XXXX

  fabricId         String
  fabric           Fabric   @relation("FabricSampleApplications", fields: [fabricId], references: [id])

  // Source recipe this application was derived from
  benchTestId      String
  benchTest        RecipeBenchTest @relation("BenchTestSampleApplications", fields: [benchTestId], references: [id])

  // What tier was applied in this run
  tier             String   // "F1" | "F2" | "F3" | "F4"

  // Bath actually prepared (snapshot of the computed recipe at run time)
  bathVolumeL             Float    @default(1.0)   // operator-selected bath volume in L
  stockMgPerL             Float    @default(30)    // FUZE stock concentration (30 ppm standard)
  bathConcentrationMgPerL Float                    // target bath concentration for this tier
  fuzeMl                  Float                    // mL of 30 ppm FUZE stock added to bath
  waterMl                 Float                    // mL of DI water added to reach bathVolumeL

  // Padder settings — pulled read-only from the bench test recipe
  squeezePressure         Float?                   // bar (e.g. 4 bar on the vertical micro-padder)
  vfdFrequencyHz          Float?                   // Hz
  lineSpeedMPerMin        Float?                   // m/min (computed from VFD Hz)
  pickupDryToWetPct       Float?                   // snapshot of bench test pickup %

  // Lifecycle
  paddedAt         DateTime?   // stamped when operator confirms pad complete
  driedAt          DateTime?   // stamped when operator confirms dryer chamber done
  operator         String?     // free-text tech name (Ashlee, etc.)
  notes            String?

  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([fabricId])
  @@index([benchTestId])
  @@index([tier])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// FABRIC REPORT SHARE
// One row per "Full Application Report" we send to a customer.
// Carries a one-time-ish download token (90-day TTL by default)
// so the customer can pull the live report without an Atlas login,
// plus a paired portal link if they DO have an account. Every view
// is counted so we can answer "did Raihana actually open it?"
// without paging through Resend logs.
// Andrew (#102): "they need the email notification that it was
// done. they need a link to download it from the email directly
// and back to the site to get it." This model is what lets that
// email link keep working a week later.
// ─────────────────────────────────────────────
model FabricReportShare {
  id        String  @id @default(cuid())
  fabricId  String
  fabric    Fabric  @relation("FabricReportShares", fields: [fabricId], references: [id])

  // Public download token (random, URL-safe). Anyone with this token
  // can fetch the report at /api/fabric-report/[token] until expiresAt.
  // Rotated by issuing a new FabricReportShare row, never re-using.
  token     String  @unique

  // Who we sent it to
  recipientEmail String
  recipientName  String?
  // Optional brand/contact links so the portal can scope "My Reports"
  // to a logged-in user without us needing to match by email string.
  brandId        String?
  contactId      String?

  // Optional note shown to the recipient ("here's the validation report
  // for Penfabric Test #2503, ICP came back at 0.94 ppm against 1.0 target")
  subjectLine String?
  emailBody   String?  // snapshot of the HTML we sent — so we can re-show it

  // Lifecycle
  sentByUserId String?
  sentAt       DateTime  @default(now())
  expiresAt    DateTime  // 90-day TTL by default — set in the create handler
  revokedAt    DateTime? // admin can revoke a stale link without deleting the row

  // Engagement
  viewedCount  Int       @default(0)
  lastViewedAt DateTime?
  // Tier the report was framed around (F1 default). Snapshot, not a join —
  // if Andrew re-tests at F2 later, the old report stays anchored to F1.
  tier         String    @default("F1")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fabricId])
  @@index([recipientEmail])
  @@index([brandId])
  @@index([contactId])
  @@index([sentAt])
}

// ─────────────────────────────────────────────
// FZ-500 · SOLARIS IR HEAT DEFLECTION PROTOCOL
// Measures how much IR / radiant heat a FUZE-treated fabric
// deflects vs a baseline (untreated) control. Test bench: IR
// bulb ~200 mm above a 175x175 mm heat plate; fabric sits
// ~45 mm above the plate on a 10 mm embroidery hoop over a
// 150 mm hole. Heat plate + air-gap + fabric-face temps are
// logged over time via a Raspberry Pi (Type K thermocouples
// on plate, SHT31 in air gap).
// ─────────────────────────────────────────────
model SolarisTest {
  id                String   @id @default(cuid())
  testNumber        String   @unique   // FUZE-SOL-YYYYMMDD-XXXX
  testDate          DateTime @default(now())

  // What's being tested
  fabricId          String?
  fabric            Fabric?  @relation("FabricSolarisTests", fields: [fabricId], references: [id])
  fabricLabel       String   // free-text if no Fabric linked
  fabricType        String?
  fiberContent      String?
  fabricWeightGsm   Float?
  fabricColor       String?  // color matters A LOT for IR absorption
  treatedAtTier     String?  // F1/F2/F3/F4, null for untreated control
  benchTestId       String?  // link to the bench test that produced this treatment

  // Device setup (snapshot at test time)
  deviceName        String?  // "Solaris Unit 1", etc.
  bulbWattage       Float?   // W of the IR bulb (e.g. 175 W)
  bulbType          String?  // "IR heat lamp · 175W · halogen", etc.
  bulbToFabricMm    Float?   @default(200)
  fabricToPlateMm   Float?   @default(45)
  hoopDiameterMm    Float?   @default(150)
  hoopThicknessMm   Float?   @default(10)
  plateWidthMm      Float?   @default(175)
  plateHeightMm     Float?   @default(175)
  plateMaterial     String?  // "anodized aluminum", etc.
  ambientTempC      Float?   // lab ambient at test start
  ambientHumidityPct Float?

  // Run durations
  runDurationSec    Int?     @default(600)  // 10 min default
  sampleIntervalMs  Int?     @default(1000) // 1 Hz default

  // Baseline run (no fabric OR untreated control fabric)
  baselineStartedAt     DateTime?
  baselineCompletedAt   DateTime?
  baselineMaxPlateTempC Float?
  baselineMaxAirTempC   Float?
  baselineTimeTo50C_sec Float?   // time (s) for plate to reach 50°C
  baselineTimeTo60C_sec Float?
  baselineRampRateCps   Float?   // °C/sec in first 60s (slope of heat rise)
  baselineSeries        Json?    // [{t_sec, plateA, plateB, air, humidity}, ...]

  // Treated run (fabric with FUZE applied)
  treatedStartedAt      DateTime?
  treatedCompletedAt    DateTime?
  treatedMaxPlateTempC  Float?
  treatedMaxAirTempC    Float?
  treatedTimeTo50C_sec  Float?
  treatedTimeTo60C_sec  Float?
  treatedRampRateCps    Float?
  treatedSeries         Json?

  // Calculated outcomes (δ = treated − baseline, negative is good)
  deltaMaxPlateC        Float?   // treated.max - baseline.max
  deltaMaxAirC          Float?
  deltaRampRateCps      Float?   // slower heat-up is better
  irDeflectionPct       Float?   // % reduction in peak temp rise vs baseline
  passFail              String?  // "PASS" | "FAIL" | "MARGINAL"
  nikeSpecMaxDeltaC     Float?   // client target if any

  notes                 String?
  qcPassed              Boolean  @default(true)
  createdById           String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([fabricId])
  @@index([testDate])
  @@index([treatedAtTier])
}

model FabricRecipe {
  id String @id @default(cuid())

  name          String    // "Cotton 180GSM Pad Application F2"

  // Fabric characteristics this recipe applies to
  fabricType    String?   // "Knit", "Woven", "Nonwoven"
  fiberContent  String?   // "100% Cotton", "65/35 Poly-Cotton", etc.
  gsmMin        Float?    // GSM range this recipe works for
  gsmMax        Float?
  yarnType      String?

  // Treatment parameters
  fuzeTier      String?   // F1, F2, F3, F4
  applicationMethod String? // "Pad", "Exhaust", "Spray", "Foam"
  padPickupPercent  Float?  // Pad pickup %
  bathConcentration Float?  // g/L or ppm
  squeezePressure   Float?  // bar/psi
  dryingTemp        Float?  // Celsius
  dryingTime        Float?  // minutes
  curingTemp        Float?  // Celsius
  curingTime        Float?  // minutes
  phRange           String? // "4.5-5.5"

  // Results achieved
  avgIcpAg      Float?    // Average silver ppm from tests
  avgReduction  Float?    // Average % reduction from AB tests
  testMethod    String?   // "AATCC 100", "ASTM E2149"
  passRate      Float?    // % of tests that passed

  // Linked test runs that validated this recipe
  validatedTestCount Int @default(0)

  notes         String?
  active        Boolean   @default(true)

  createdById   String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([fabricType])
  @@index([fiberContent])
  @@index([fuzeTier])
  @@index([applicationMethod])
}

// ─────────────────────────────────────────────
// CURRENCY & EXCHANGE RATES
// ─────────────────────────────────────────────

model ExchangeRate {
  id String @id @default(cuid())

  fromCurrency String   // "USD"
  toCurrency   String   // "CNY"
  rate         Float    // 1 USD = X CNY
  source       String?  // "manual", "api", "bank"

  effectiveDate DateTime

  createdAt DateTime @default(now())

  @@unique([fromCurrency, toCurrency, effectiveDate])
  @@index([fromCurrency, toCurrency])
  @@index([effectiveDate])
}

// ─────────────────────────────────────────────
// BRAND ENGAGEMENT SCORING
// ─────────────────────────────────────────────

model BrandEngagement {
  id String @id @default(cuid())

  brandId     String    @unique
  brand       Brand     @relation("BrandEngagement", fields: [brandId], references: [id])

  // Scores (0-100)
  overallScore     Int   @default(50)
  communicationScore Int @default(50)  // Days since last note/contact
  testingVelocity   Int @default(50)  // Tests completed per month
  pipelineVelocity  Int @default(50)  // Speed moving through stages
  paymentScore      Int @default(50)  // Invoice payment timeliness
  engagementTrend   String @default("STABLE") // RISING, STABLE, DECLINING, AT_RISK

  // Raw metrics
  daysSinceLastContact Int?
  testsLast30Days      Int @default(0)
  testsLast90Days      Int @default(0)
  avgInvoicePayDays    Float?
  overdueInvoices      Int @default(0)
  stageChanges90Days   Int @default(0)

  lastCalculated DateTime @default(now())

  @@index([overallScore])
  @@index([engagementTrend])
}

// ─────────────────────────────────────────────
// MEETINGS / CALENDAR
// ─────────────────────────────────────────────

model Meeting {
  id String @id @default(cuid())

  title       String
  description String?
  meetingType String    @default("INTERNAL")   // INTERNAL, BRAND_PRESENTATION, TESTING_REVIEW, FACTORY_KICKOFF, PRODUCTION_REVIEW, SOW_REVIEW, CUSTOM

  // Schedule
  startTime   DateTime
  endTime     DateTime
  timezone    String    @default("Asia/Taipei")
  location    String?                           // Physical location or "Microsoft Teams" / "Zoom"
  teamsLink   String?                           // Auto-generated Teams deep link
  calendarUrl String?                           // .ics download URL

  // Relations
  brandId   String?
  brand     Brand?   @relation("MeetingBrand", fields: [brandId], references: [id])
  projectId String?
  project   Project? @relation("MeetingProject", fields: [projectId], references: [id])

  // Pipeline trigger
  pipelineStage String?                         // Which stage triggered this meeting
  autoScheduled Boolean @default(false)         // Was this auto-created by pipeline movement?

  // Organizer & attendees stored as JSON
  organizerId String?
  organizer   User?    @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  attendees   Json?                             // [{name, email, role}]

  status    String   @default("SCHEDULED")      // SCHEDULED, COMPLETED, CANCELLED, RESCHEDULED
  notes     String?                             // Post-meeting notes
  outcome   String?                             // Meeting outcome summary

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startTime])
  @@index([brandId])
  @@index([projectId])
  @@index([status])
  @@index([meetingType])
}

// ─────────────────────────────────────────────
// AVAILABILITY CONFIG (for self-booking system)
// ─────────────────────────────────────────────

model AvailabilityConfig {
  id                    String   @id @default("default")
  availableDays         Json     @default("[2,4]")                    // 0=Sunday, 2=Tuesday, 4=Thursday, etc
  startHour             Int      @default(9)                          // 9 = 9 AM
  endHour               Int      @default(17)                         // 5 PM
  slotDurationMinutes   Int      @default(60)
  timezone              String   @default("Asia/Taipei")
  blockedDates          Json     @default("[]")                       // ISO date strings
  maxBookingsPerDay     Int      @default(3)
  updatedAt             DateTime @updatedAt
}

// ─────────────────────────────────────────────
// COMPLIANCE LIBRARY — SDS, TDS, Bluesign, ZDHC, Oeko-Tex, GOTS
// ─────────────────────────────────────────────

model ComplianceDocument {
  id String @id @default(cuid())

  title       String
  description String?
  category    String   @default("OTHER") // Flexible string categories (SDS_MSDS, TDS, BLUESIGN, ZDHC, OEKO_TEX, GOTS, EPA, REACH, COA, COC, ISO, IMPORT_EXPORT, OTHER, or custom)
  version     String?
  filename    String?
  contentType String?
  sizeBytes   Int?
  url         String?
  data        String?            // base64 data URL for inline storage (legacy — prefer S3)
  s3Key       String?            // S3 object key for files uploaded via presigned URL

  // Role-based visibility: JSON array of role strings e.g. ["ADMIN","BRAND_USER","FACTORY_USER"]
  // If empty/null, only ADMIN can see it
  visibleTo Json @default("[\"ADMIN\",\"EMPLOYEE\",\"BRAND_USER\",\"FACTORY_USER\",\"FACTORY_MANAGER\"]")

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([uploadedById])
}

// ─────────────────────────────────────────────
// SAMPLE TRIAL REQUESTS
// Factory requests FUZE product sample for trial application
// ─────────────────────────────────────────────

model SampleTrialRequest {
  id                  String   @id @default(cuid())

  // Who's requesting
  factoryId           String
  factory             Factory  @relation("FactoryTrials", fields: [factoryId], references: [id])
  requestedById       String
  requestedBy         User     @relation("TrialRequester", fields: [requestedById], references: [id])

  // What fabric (must exist — if not, factory submits fabric first)
  fabricId            String
  fabric              Fabric   @relation("FabricTrials", fields: [fabricId], references: [id])

  // For whom — brand partnership or self-development
  purposeType         String   // BRAND_PARTNERSHIP | SELF_DEVELOPMENT
  brandId             String?
  brand               Brand?   @relation("TrialBrand", fields: [brandId], references: [id])
  partnershipNote     String?  // Free text if brand not in system yet

  // Trial details
  trialType           String   // LAB_TRIAL | PRODUCTION_TRIAL
  totalMeters         Float    // Total fabric meters/yards to be treated
  totalUnit           String   @default("meters") // meters | yards
  targetFuzeTier      String?  // F1, F2, F3, F4
  applicationMethod   String?  // exhaust | pad | spray

  // FUZE sample shipment
  sampleVolumeLiters  Float?   // Calculated from fabric params + tier
  shippingAddress     String?  // Factory address for sample delivery
  shippingCity        String?
  shippingState       String?
  shippingPostalCode  String?
  shippingCountry     String?
  shippingContactName String?
  shippingContactPhone String?
  shippingContactEmail String?

  // Shipping account — factory pays freight on US-origin samples
  shippingCarrier       String?  // FedEx, DHL, UPS, etc.
  shippingAccountNumber String?  // Their carrier account number for billing
  shippingMethod        String?  // EXPRESS | STANDARD | ECONOMY
  shippingOrigin        String?  @default("US") // US = ships from FUZE USA, DISTRIBUTOR = in-country
  shippingNotes         String?  // Special instructions, broker info, customs notes

  // ICP Lab commitment (mandatory)
  icpLabId            String?
  icpLab              Lab?     @relation("TrialIcpLab", fields: [icpLabId], references: [id])
  icpLabOther         String?  // If lab not yet in system
  icpCommitDate       DateTime? // When they commit to send for ICP testing

  // Status workflow
  // SUBMITTED → UNDER_REVIEW → APPROVED → SAMPLE_SHIPPED →
  // SAMPLE_RECEIVED → TRIAL_IN_PROGRESS → ICP_PENDING →
  // ICP_SUBMITTED → COMPLETE  (or REJECTED at any point)
  status              String   @default("SUBMITTED")

  // Admin tracking
  approvedById        String?
  approvedAt          DateTime?
  rejectedReason      String?
  sampleTrackingNumber String?
  sampleShippedDate   DateTime?
  sampleReceivedDate  DateTime?

  // ICP follow-up
  icpTestRunId        String?  // Links to actual ICP TestRun when results submitted
  icpSubmittedAt      DateTime?
  icpAgValue          Float?   // Quick-reference Ag result
  icpAuValue          Float?   // Quick-reference Au result

  notes               String?
  adminNotes          String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([factoryId])
  @@index([fabricId])
  @@index([brandId])
  @@index([status])
  @@index([icpLabId])
}

// ─────────────────────────────────────────────
// API CALL AUDIT LOG
// ─────────────────────────────────────────────

model ApiCallLog {
  id          String   @id @default(cuid())
  provider    String   // "openai" | "anthropic"
  callerRoute String   // "chat" | "research" | "test-review" | "fabric-intake"
  userId      String?  // from x-user-id header (who triggered it)
  statusCode  Int      // HTTP status from the AI API
  durationMs  Int      // how long the call took
  attempt     Int      @default(0) // retry attempt number
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([provider])
  @@index([statusCode])
}

// ─────────────────────────────────────────────
// DISTRIBUTOR PRICING & INVENTORY
// Distributors maintain their own pricing per region/factory
// and keep inventory levels current in Atlas
// ─────────────────────────────────────────────

model DistributorPricing {
  id              String   @id @default(cuid())

  distributorId   String
  distributor     Distributor @relation("DistributorPricing", fields: [distributorId], references: [id])

  // ─── Tier (1..5) ──────────────────────────────────
  // Each distributor maintains up to 5 pricing tiers driven by
  // geography, shipping cost, tariff/duty, and end-use margin
  // (surface disinfectant for pro teams vs cotton sheet finishing
  // is a 2-tier example). Tiers are referenced by index 1..5.
  // tierName is free-text — distributors can rename per their own
  // commercial logic ("US/CA Premium", "EU Hospitality", etc.) but
  // we ship with a generic "Tier 1..5" so the labels don't bake in
  // any opaque assumptions.
  // tierIndex null = legacy default row (the single-tier shape we had
  // before the multi-tier rollout). Order pricing falls back to the
  // isDefault row when a factory's assigned tier doesn't match.
  tierIndex       Int?     // 1..5
  tierName        String?  // free-text label

  // Scope: can be per-factory, per-region, or default
  factoryId       String?  // If set, price applies to this factory only
  factory         Factory? @relation("FactoryDistributorPricing", fields: [factoryId], references: [id])
  region          String?  // APAC, EMEA, LATAM, NAM, etc. — if set, applies to region
  country         String?  // If set, applies to this country only

  // FUZE product pricing
  pricePerLiter   Float    // Distributor's price to factory
  currency        String   @default("USD")
  minOrderLiters  Float?   // Minimum order volume
  leadTimeDays    Int?     // Estimated delivery time

  // Tiered volume discounts (JSON array)
  // [{ minLiters: 100, discountPct: 5 }, { minLiters: 500, discountPct: 10 }]
  volumeDiscounts Json?

  // Hangtag pricing
  hangtagPricePerUnit Float?  // Price per hangtag
  hangtagMinOrder     Int?    // Minimum hangtag order

  isDefault       Boolean  @default(false)  // Default pricing for this distributor
  active          Boolean  @default(true)

  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([distributorId])
  @@index([factoryId])
  @@index([region])
  @@index([tierIndex])
}

model DistributorInventory {
  id              String   @id @default(cuid())

  distributorId   String
  distributor     Distributor @relation("DistributorInventory", fields: [distributorId], references: [id])

  // Stock on hand
  fuzeStockLiters Float    @default(0)  // Current FUZE product stock in liters
  fuzeStockBottles Int     @default(0)  // Current stock in 19L bottles
  hangtagStock    Int      @default(0)  // Hangtags in stock

  // Reorder thresholds
  reorderPointLiters Float?  // Auto-alert when stock drops below
  reorderQtyLiters   Float?  // Suggested reorder quantity

  // Last updated
  lastStockUpdate DateTime?
  lastAuditDate   DateTime?
  updatedById     String?

  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([distributorId])
}

// ─────────────────────────────────────────────
// FUZE PRODUCT ORDERS & CONSUMPTION
// ALL orders flow through Atlas:
// Factory submits → Quote generated → Account Manager approves →
// Routed to distributor or direct from USA → Fulfilled → Delivered
// ─────────────────────────────────────────────

model FuzeOrder {
  id              String   @id @default(cuid())

  // Who ordered
  factoryId       String
  factory         Factory  @relation("FactoryOrders", fields: [factoryId], references: [id])
  orderedById     String?
  orderedBy       User?    @relation("OrderUser", fields: [orderedById], references: [id])

  // What was ordered
  orderNumber     String   @unique  // FUZE-ORD-YYYYMMDD-XXXX
  orderType       String   @default("PRODUCTION")  // PRODUCTION | SAMPLE | HANGTAG
  volumeLiters    Float?   // Total liters ordered (for PRODUCTION/SAMPLE)
  fuzeTier        String?  // F1/F2/F3/F4
  bottles         Int?     // Number of 19L bottles

  // Hangtag orders
  hangtagQty      Int?     // Number of hangtags (for HANGTAG orders)
  hangtagDesign   String?  // Design variant

  // Brand & fabric context (what is this order for?)
  brandId         String?
  brand           Brand?   @relation("OrderBrand", fields: [brandId], references: [id])
  fabricId        String?
  fabric          Fabric?  @relation("OrderFabric", fields: [fabricId], references: [id])
  purposeNote     String?  // "New account development", "Production run for Rhone Q3", etc.

  // Quote (auto-generated from distributor pricing)
  quoteNumber     String?  // FUZE-QTE-YYYYMMDD-XXXX
  pricePerLiter   Float?   // From distributor pricing or manual
  pricePerHangtag Float?   // For hangtag orders
  totalPrice      Float?
  currency        String   @default("USD")
  discountPct     Float?   // Volume discount applied
  quoteExpiresAt  DateTime?
  quoteAccepted   Boolean  @default(false)
  quoteAcceptedAt DateTime?

  // Fulfillment routing
  fulfillmentSource String?  // DISTRIBUTOR | DIRECT_USA
  distributorId   String?
  distributor     Distributor? @relation("OrderDistributor", fields: [distributorId], references: [id])

  // Account manager approval
  accountManagerId String?
  accountManager   User?   @relation("OrderAccountManager", fields: [accountManagerId], references: [id])
  approvedAt      DateTime?
  approvedById    String?

  // Sample support (FUZE subsidizes sample costs)
  isSampleSubsidized Boolean @default(false)
  subsidyAmount      Float?   // USD amount FUZE covers
  subsidyNote        String?

  // Shipping
  trackingNumber  String?
  carrier         String?
  shippedDate     DateTime?
  deliveredDate   DateTime?
  shippingAddress String?
  shippingCity    String?
  shippingCountry String?

  // Status workflow:
  // DRAFT → QUOTED → PENDING_APPROVAL → APPROVED → PROCESSING → SHIPPED → DELIVERED → CANCELLED
  status          String   @default("DRAFT")

  // Reorder tracking
  isReorder       Boolean  @default(false)
  previousOrderId String?

  // Production batch this order was filled from (set at ship time)
  batchId         String?
  batch           ProductionBatch? @relation("OrderBatch", fields: [batchId], references: [id])

  // Fabric spec & wastage (factory production orders)
  fabricWeightGsm    Float?   // Fabric weight in g/m²
  fabricLengthMeters Float?   // Total fabric length
  fabricWidthMeters  Float?   // Fabric width
  fabricMassKg       Float?   // Total fabric mass (kg) — either entered or computed
  treatmentMethod    String?  // EXHAUST | PAD_DRY_CURE | SPRAY
  baseFuzeLiters     Float?   // Calculated FUZE needed before wastage
  wastageFactorPct   Float?   @default(10)  // Wastage / safety buffer %

  notes           String?
  adminNotes      String?
  factoryNotes    String?  // Factory's internal notes

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  consumptions    FuzeConsumption[]
  brandAllocations OrderBrandAllocation[]
  lifecycleEvents OrderLifecycleEvent[] @relation("OrderLifecycle")

  @@index([factoryId])
  @@index([brandId])
  @@index([distributorId])
  @@index([accountManagerId])
  @@index([status])
  @@index([orderType])
  @@index([orderNumber])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// ORDER BRAND ALLOCATION
// Tracks which brands a factory is ordering FUZE for
// Enables: AM commission credit, brand rebates, volume tracking
// ─────────────────────────────────────────────
model OrderBrandAllocation {
  id              String   @id @default(cuid())

  orderId         String
  order           FuzeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  brandId         String
  brand           Brand    @relation("BrandOrderAllocations", fields: [brandId], references: [id])

  // Volume allocation for this brand
  allocatedLiters Float?   // Liters allocated to this brand
  allocatedPct    Float?   // Percentage of order volume (0-100)
  hangtagQty      Int?     // Hangtags for this brand (hangtag orders)

  // Notes from factory about this brand's usage
  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orderId, brandId])
  @@index([brandId])
  @@index([orderId])
}

// ─────────────────────────────────────────────
// PRODUCTION BATCH
// Every FUZE production run creates a batch. One QR sticker design
// is printed per batch and applied identically to every carboy from
// that batch. Scanning the QR (batch-level) returns batch-specific
// COA plus the product-wide TDS and SDS.
// ─────────────────────────────────────────────
model ProductionBatch {
  id              String   @id @default(cuid())
  batchCode       String   @unique  // FB-YYYYMMDD-XXXX e.g. FB-20260413-0007
  productionDate  DateTime
  volumeProducedLiters Float
  bottlesFilled   Int?     // 19L carboys filled from this batch

  // Documents specific to this batch
  coaDocUrl       String?  // Certificate of Analysis (per-batch)
  coaUploadedAt   DateTime?
  coaUploadedById String?

  // Production details
  ablationRunIds  String?  // JSON: ["run-001","run-002"]
  concentrationMgPerL Float? @default(30)
  qcPassed        Boolean  @default(true)
  qcNotes         String?

  notes           String?

  // Orders fulfilled from this batch (set at ship time)
  orders          FuzeOrder[] @relation("OrderBatch")
  scans           BatchScanLog[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([batchCode])
  @@index([productionDate])
}

// ─────────────────────────────────────────────
// BATCH SCAN AUDIT LOG
// Every time someone scans a batch QR (requires Atlas login), we
// record it. Becomes a traceability trail for customers, auditors,
// and forensic investigations if QC issues ever arise.
// ─────────────────────────────────────────────
model BatchScanLog {
  id        String   @id @default(cuid())

  batchId   String
  batch     ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  userId    String?  // Atlas user who scanned (null if public access later enabled)
  userName  String?  // Cached display name
  userRole  String?  // ADMIN, FACTORY_USER, BRAND_USER, etc.

  ipAddress String?
  userAgent String?
  location  String?  // Factory name / brand name / free text

  createdAt DateTime @default(now())

  @@index([batchId])
  @@index([userId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// PRODUCT DOCUMENTS (Global — TDS, master SDS)
// These are product-wide documents that apply to every batch of
// FUZE. Stored once, referenced everywhere. COA is per-batch (on
// ProductionBatch.coaDocUrl).
// ─────────────────────────────────────────────
model ProductDocument {
  id          String   @id @default(cuid())
  docType     String   @unique  // TDS | SDS | PRODUCT_SPEC | HANDLING_GUIDE | APPLICATION_GUIDE
  title       String
  description String?
  fileUrl     String
  version     String?  // e.g. "v3.1"
  effectiveDate DateTime?
  expiresAt   DateTime?

  uploadedById String?
  uploadedByName String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([docType])
}

// ─────────────────────────────────────────────
// ORDER LIFECYCLE EVENTS
// Unified audit trail for a FuzeOrder: ship → receive → treat → test → certify
// Feeds the public shipment verification page (QR destination)
// ─────────────────────────────────────────────
model OrderLifecycleEvent {
  id        String   @id @default(cuid())

  orderId   String
  order     FuzeOrder @relation("OrderLifecycle", fields: [orderId], references: [id], onDelete: Cascade)

  eventType String   // ORDER_PLACED | QUOTE_ACCEPTED | APPROVED | SHIPPED_FROM_FUZE |
                     // SHIPPED_FROM_DISTRIBUTOR | IN_TRANSIT | CUSTOMS |
                     // RECEIVED_AT_FACTORY | TREATMENT_APPLIED | ICP_SAMPLE_SUBMITTED |
                     // ICP_CERTIFIED | BRAND_NOTIFIED | CANCELLED | NOTE
  title     String   // Short human-readable label
  description String? // Longer narrative
  location  String?
  actorId   String?  // User who logged the event
  actorName String?  // Cached display name

  // Structured payload for specific event types
  data      Json?    // { metersProcessed, litersUsed, method, trackingNumber, carrier, labId, certificateUrl, ... }

  photoUrl  String?
  documentUrl String? // Link to SDS/COA/BOL/certificate

  isPublic  Boolean  @default(true)  // Hide internal notes from public QR page

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([eventType])
  @@index([createdAt])
}

model FuzeConsumption {
  id              String   @id @default(cuid())

  // Who used it
  factoryId       String
  factory         Factory  @relation("FactoryConsumption", fields: [factoryId], references: [id])

  // Against which order
  orderId         String?
  order           FuzeOrder? @relation(fields: [orderId], references: [id])

  // Usage details
  litersUsed      Float    // How many liters consumed
  metersProcessed Float?   // How many meters of fabric treated
  applicationMethod String? // exhaust | pad | spray
  fuzeTier        String?  // F1/F2/F3/F4

  // Production context
  brandId         String?
  brand           Brand?   @relation("ConsumptionBrand", fields: [brandId], references: [id])
  fabricId        String?
  fabric          Fabric?  @relation("ConsumptionFabric", fields: [fabricId], references: [id])
  productionRunId String?  // Factory's internal reference

  // Date of consumption
  usageDate       DateTime @default(now())
  reportedById    String?

  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([factoryId])
  @@index([orderId])
  @@index([usageDate])
  @@index([brandId])
}

// ─────────────────────────────────────────────
// FEEDBACK / REPORT-A-PROBLEM WIDGET
// ─────────────────────────────────────────────

model FeedbackReport {
  id String @id @default(cuid())

  // Who reported (may be null for unauthenticated pages, though we expect auth everywhere)
  userId     String?
  user       User?   @relation("FeedbackSubmitter", fields: [userId], references: [id])
  userEmail  String? // cached so we can email even if user is later deleted
  userName   String?
  userRole   String? // cached role at time of submission

  // Classification
  category String // PROBLEM | CONFUSING | MISSING | SUGGESTION | BROKEN_LINK | ERROR | OTHER
  title    String
  description String @db.Text

  // Auto-captured context (all optional so we gracefully degrade)
  url       String?   // full URL the user was on
  portal    String?   // e.g. "lab-portal", "brand-portal", "admin", "crm"
  userAgent String?
  viewport  String?   // "1440x900"
  referer   String?

  // Optional screenshot — S3 key + public URL (or base64 data-URL fallback)
  screenshotUrl    String?
  screenshotBucket String?
  screenshotKey    String?

  // Triage + resolution
  status       FeedbackStatus @default(NEW)
  triagedById  String?
  triagedAt    DateTime?
  triageNotes  String?  @db.Text

  resolvedById   String?
  resolvedAt     DateTime?
  resolution     String? @db.Text   // what was fixed, shown to user on notification
  resolutionUrl  String?            // optional link to the feature / page / PR

  notifiedAt   DateTime?            // when we emailed the requester that it was fixed

  priority Int? // 1 (critical) — 5 (nice-to-have)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

enum FeedbackStatus {
  NEW           // just submitted, needs triage
  TRIAGED       // reviewed, awaiting decision
  ACCEPTED      // agreed, going to fix
  IN_PROGRESS   // actively being fixed
  FIXED         // done, requester notified
  REJECTED      // wont fix / not a bug
  DUPLICATE     // merged into another report
  CLOSED
}

// ─────────────────────────────────────────────
// WEEKLY EXEC REVIEW
// ─────────────────────────────────────────────
// A persisted weekly snapshot for the Monday exec meeting. One row per
// week, keyed by the Monday of the week in UTC (weekOf). The snapshot
// column holds the fully-computed report payload (KPIs, lists, stage
// waterfall) so the dashboard renders instantly and historical weeks
// stay frozen even as underlying records change.
//
// Access model:
//   • ownedById — the user who owns the report (initially Andrew).
//   • shares    — explicit per-user grants via WeeklyExecReportShare.
//   • ADMINs    — always allowed (emergency override, audit-logged).
//
// Notes authored inline during review can optionally back-link via
// Note.weeklyReportId so the appendix shows the review's paper trail.

model WeeklyExecReport {
  id String @id @default(cuid())

  // Monday 00:00 UTC for the covered week. For the first "2-week backfill"
  // run we still file the report under the most recent Monday and include
  // the prior week inside the snapshot.
  weekOf   DateTime @unique
  // Optional lookback override — when > 7 days, the snapshot's period
  // starts at (weekOf - lookbackDays) instead of the prior Monday.
  lookbackDays Int @default(7)

  // Fully computed report payload. Shape lives in
  // src/lib/weekly-review/types.ts — never read fields directly from
  // the DB, always go through the typed helpers.
  snapshot Json

  // When the snapshot was last regenerated. Regeneration is explicit
  // (user hits "Refresh") to keep historical weeks pinned.
  generatedAt DateTime @default(now())

  // Optional exec summary authored by the owner at review time.
  execNote String? @db.Text

  // Lifecycle — DRAFT → IN_REVIEW → REVIEWED → ARCHIVED. Drives the
  // "Present" affordance and which weeks show up in the left rail.
  status String @default("DRAFT")

  ownedById String
  ownedBy   User   @relation("WeeklyReportOwner", fields: [ownedById], references: [id])

  shares WeeklyExecReportShare[]
  notes  Note[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownedById])
  @@index([status])
  @@index([weekOf])
}

// Per-user grant to view/comment on a specific weekly report.
// scope = "FULL"   → can read everything on the page.
// scope = "KPI"    → reserved for later; read KPI tiles only.
model WeeklyExecReportShare {
  id String @id @default(cuid())

  reportId String
  report   WeeklyExecReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("WeeklyShareRecipient", fields: [userId], references: [id])

  grantedById String
  grantedBy   User   @relation("WeeklyShareGrantor", fields: [grantedById], references: [id])

  scope     String   @default("FULL")
  grantedAt DateTime @default(now())

  @@unique([reportId, userId])
  @@index([userId])
  @@index([reportId])
}

// ─────────────────────────────────────────────
// BD WIZARD PHASE 3 — LONG-FUNNEL ORCHESTRATION
//
// A BDSequence is one rep's multi-step outbound campaign against one
// contact at one brand. The default cadence is 6 steps over ~30 days,
// mixing channels (email, LinkedIn manual, paid retargeting, tradeshow).
//
// Lifecycle:
//   created  → first step is "sent" (the wizard's initial email goes out
//              and creates the sequence as a side effect)
//   active   → subsequent steps tick into "ready" status as their
//              scheduledFor passes; rep approves & sends each one
//   completed→ all steps consumed (sent or skipped)
//   exited   → manual stop, reply detected, or meeting booked
//
// One sequence per (brand, contact, rep) — uniqueness enforced. If the
// rep wants to re-engage after exit, they exit the old one first then
// create a new one (Phase 4 will add restart UX).
//
// Steps don't auto-send. Per Andrew's locked decision (2026-04-20):
// "Always queue for review — no auto-send ever". The cron generates
// the draft and parks the step in the rep's ACM task queue.
// ─────────────────────────────────────────────
model BDSequence {
  id String @id @default(cuid())

  brandId String
  brand   Brand @relation("BrandBDSequences", fields: [brandId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation("ContactBDSequences", fields: [contactId], references: [id], onDelete: Cascade)

  repId String
  rep   User @relation("UserBDSequences", fields: [repId], references: [id])

  // Cadence template applied at creation. "default" = the 6-step long funnel.
  // Future cadences (e.g. "premium_light_touch") will live in src/lib/bd-sequence.ts
  // and reference this string.
  cadenceKey String @default("default")

  status      String   @default("active") // active | paused | completed | exited
  exitReason  String?  // replied | meeting_booked | unqualified | manual_stop | replaced
  startedAt   DateTime @default(now())
  completedAt DateTime?

  // Cached counters so the dashboard doesn't have to count steps each render.
  // Updated whenever a step transitions. Approximate — recomputed authoritatively
  // by /api/admin/bd/sequences when stale.
  totalSteps   Int @default(0)
  sentSteps    Int @default(0)
  skippedSteps Int @default(0)

  steps BDSequenceStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One ACTIVE sequence per (brand, contact, rep). Exited/completed runs
  // stay in the table for history but don't block creating a new one — the
  // application code enforces "no overlapping active runs" at insert time
  // since Postgres can't do conditional uniqueness without a partial index,
  // and Prisma 6 doesn't model partial indexes natively yet.
  @@unique([brandId, contactId, repId, status])
  @@index([repId, status])
  @@index([brandId])
  @@index([status])
}

model BDSequenceStep {
  id String @id @default(cuid())

  sequenceId String
  sequence   BDSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  stepIndex Int      // 0-based position in the cadence
  channel   String   // email | linkedin_connect | linkedin_dm | paid | tradeshow
  status    String   @default("pending") // pending | ready | sent | skipped | failed

  // When this step becomes eligible for the rep to review/send. Cron looks
  // for status="pending" AND scheduledFor <= now() and flips to "ready".
  scheduledFor DateTime
  readyAt      DateTime?  // when cron generated the draft
  sentAt       DateTime?
  skippedAt    DateTime?
  failedAt     DateTime?
  failReason   String?

  // Draft content — generated by cron for email/LinkedIn steps, then editable
  // by the rep before they hit send. For paid/tradeshow steps these stay null.
  draftSubject String?
  draftBody    String?

  // Link out to the OutreachMessage row that captures the actual send (only
  // populated once status="sent" for email/LinkedIn). Loose FK — no Prisma
  // relation — because OutreachMessage is owned by Contact and we don't want
  // a cascade chain back through here.
  outreachMessageId String?

  // Optional CrmTask we created on /acm/tasks for the rep. Populated when
  // status flips to "ready". Used by the UI to deep-link from the task list
  // back to the wizard. Loose FK for the same reason as outreachMessageId.
  crmTaskId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cron query: find steps that are due to flip from pending → ready.
  @@index([status, scheduledFor])
  @@index([sequenceId, stepIndex])
}

// ─────────────────────────────────────────────
// EMAIL TEMPLATES (ticket #24 — Viktor 4/17)
// ─────────────────────────────────────────────
//
// Reusable email scaffolds for common outreach (first intro, re-engagement,
// ICP request, etc.). Loaded by the Atlas compose dialog and BD wizard.
//
// Scope:
//   - PRIVATE: only the owner sees/uses it.
//   - SHARED:  any internal user (EMPLOYEE+) sees it. ADMIN can edit.
//   - GLOBAL:  reserved for ADMIN-curated org-wide defaults.
//
// Variable substitution happens client-side at compose time. Supported tokens
// today (kept loose on purpose — the renderer just does string-replace):
//   {firstName}  {lastName}  {fullName}  {company}  {title}
//   {senderName} {senderEmail}
// New tokens can be added without a schema change.
model EmailTemplate {
  id      String @id @default(cuid())

  title   String   // human-readable label shown in the picker
  subject String   // may contain {variables}
  body    String   @db.Text // HTML or plain — renderer is forgiving
  // Optional category tag for grouping in the picker. Free-form string today —
  // we may promote to enum once usage settles.
  category String?

  scope   EmailTemplateScope @default(PRIVATE)

  // Owner — null only for GLOBAL templates seeded via migration. PRIVATE
  // templates are filtered by ownerId === currentUser.id; SHARED ignore owner
  // for read but require it match (or admin) for edit/delete.
  ownerId String?
  owner   User?   @relation("EmailTemplateOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  // Soft-delete so we don't break historical references in OutreachMessage if
  // we ever back-link templateId there.
  archivedAt DateTime?

  // Lightweight usage stats — incremented on /api/email-templates/[id]/use
  // when the picker actually injects this template into a compose draft.
  // Useful for "show most-used first" UX without a separate analytics table.
  useCount Int @default(0)
  lastUsedAt DateTime?

  // Per-user BD Wizard quick-pick slot (1-10). When set, this template shows
  // up on the wizard Draft step as a numbered button the rep can one-click to
  // populate subject + body — the "BD rep keeps their favourite 10 openers
  // one keystroke away" pattern (Andrew 2026-04-22). Unique per owner so slot
  // N can only hold one template at a time; re-assigning a new template to a
  // slot clears the previous one in the same transaction (server-side).
  // PRIVATE scope only — we don't want a BD rep's personal slot map polluted
  // by SHARED/GLOBAL templates.
  bdSlot Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, scope])
  @@index([scope, archivedAt])
  @@index([category])
  @@unique([ownerId, bdSlot], name: "owner_bdSlot_unique")
}

enum EmailTemplateScope {
  PRIVATE
  SHARED
  GLOBAL
}
