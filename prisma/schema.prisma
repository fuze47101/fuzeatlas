generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum SourceSystem {
  KNACK
  CSV
  MANUAL
  API
}

enum PipelineStage {
  LEAD
  PRESENTATION
  BRAND_TESTING
  FACTORY_ONBOARDING
  FACTORY_TESTING
  PRODUCTION
  BRAND_EXPANSION
  ARCHIVE
  CUSTOMER_WON
}

enum TestType {
  ICP
  ANTIBACTERIAL
  FUNGAL
  ODOR
  UV
  MICROFIBER
  OTHER
}

enum TestStatus {
  REQUESTED
  IN_PROGRESS
  PASSED
  FAILED
  RETEST
  PASSED_COMPLETE
}

enum DocKind {
  REPORT
  IMAGE
  SUBMISSION_DOC
  SOW_DOC
  LAB_FORM
  OTHER
}

// ComplianceCategory is now a free-form String on ComplianceDocument.category
// Built-in values: SDS_MSDS, TDS, BLUESIGN, ZDHC, OEKO_TEX, GOTS, EPA, REACH, COA, COC, ISO, IMPORT_EXPORT, OTHER
// Admins can also create custom categories

enum SOWStatus {
  DRAFT
  SENT
  SIGNED
  ACTIVE
  COMPLETE
  CANCELLED
}

enum UserRole {
  ADMIN
  EMPLOYEE
  SALES_MANAGER
  SALES_REP
  BD_REP             // Independent BD reps / commission-only partners (Viktor, Barth, Hi-Goal, etc.)
  FABRIC_MANAGER
  TESTING_MANAGER
  FACTORY_MANAGER
  FACTORY_USER
  BRAND_USER
  DISTRIBUTOR_USER
  LAB_USER
  PUBLIC
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
}

// ─────────────────────────────────────────────
// COMPETITOR PRICE OVERRIDES (admin espionage data)
// ─────────────────────────────────────────────

model CompetitorPriceOverride {
  id              String  @id @default(cuid())
  competitorId    String  @unique  // matches id from COMPETITORS array in competitors.ts

  // Distributor pricing (real espionage data from China distributors etc.)
  chemicalPricePerKg         Float?   // USD/kg of antimicrobial as purchased
  chemicalPriceSource        String?  // "China distributor quote", "India contact", etc.
  chemicalPriceDate          DateTime? // when the price was obtained

  // Binder pricing overrides
  binderPricePerKg           Float?   // USD/kg of binder chemical

  // Application cost overrides (per linear meter)
  estimatedCostPerMeterLow      Float?
  estimatedCostPerMeterHigh     Float?
  estimatedCostPerMeterTypical  Float?

  // Re-treatment multiplier override
  retreatmentCostMultiplier  Float?

  // Notes
  notes          String?  // free-form notes about the source, confidence, etc.

  updatedBy      String?  // user name who last updated
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([competitorId])
}

// ─────────────────────────────────────────────
// AUDIT / IMPORT TRACKING
// ─────────────────────────────────────────────

model SourceRecord {
  id             String       @id @default(cuid())
  sourceSystem   SourceSystem @default(CSV)
  sourceTable    String
  sourceRecordId String?
  sourceKey      String?
  raw            Json
  importedAt     DateTime     @default(now())

  brandId      String?
  factoryId    String?
  labId        String?
  submissionId String?
  testRunId      String?
  distributorId  String?

  brand      Brand?            @relation(fields: [brandId], references: [id])
  factory    Factory?          @relation(fields: [factoryId], references: [id])
  lab        Lab?              @relation(fields: [labId], references: [id])
  submission FabricSubmission? @relation(fields: [submissionId], references: [id])
  testRun    TestRun?          @relation(fields: [testRunId], references: [id])
  distributor Distributor?      @relation(fields: [distributorId], references: [id])

  @@index([sourceSystem, sourceTable])
  @@index([sourceRecordId])
}

// ─────────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────────

model User {
  id       String     @id @default(cuid())
  name     String
  email    String     @unique
  password String?
  role     UserRole   @default(PUBLIC)
  status   UserStatus @default(ACTIVE)

  // Security flags
  mustChangePassword Boolean  @default(false)  // Force password change on next login
  emailVerified      Boolean  @default(false)  // Email address verified
  emailVerifyToken   String?  @unique          // Verification token
  emailVerifyExpiry  DateTime?                 // Token expiry
  passwordChangedAt  DateTime?                 // Last password change timestamp

  // BD Portal — can this user claim unclaimed brand accounts?
  // Admins always can (enforced in code). Everyone else needs canClaim = true.
  canClaim Boolean @default(false)

  // BD Wizard — the From: address we use when this rep sends outbound via
  // the wizard. Null = fall back to the user's Atlas login email. Reps
  // set this on /settings/profile so they can separate "my Atlas account"
  // from "the inbox where replies should land." E.g. andrew@801inc.com
  // is the login but andrew@fuze47.com is the outbound.
  outboundFromEmail String?
  // Name shown on outbound. Defaults to the user's `name` if null.
  outboundFromName  String?
  // Optional email signature block (HTML-safe text) appended to every
  // wizard-sent outbound. Reps paste their own signature here once;
  // it flows through to every cold email.
  outboundSignature String?

  salesManagerId String?
  salesManager   User?   @relation("SalesManagerReps", fields: [salesManagerId], references: [id])
  managedReps    User[]  @relation("SalesManagerReps")

  brandId       String?
  brand         Brand?       @relation("BrandUsers", fields: [brandId], references: [id])
  factoryId     String?
  factory       Factory?     @relation("FactoryUsers", fields: [factoryId], references: [id])
  distributorId String?
  distributor   Distributor? @relation("DistributorUsers", fields: [distributorId], references: [id])
  labId         String?
  lab           Lab?         @relation("LabUsers", fields: [labId], references: [id])

  assignedBrands    Brand[]    @relation("BrandSalesRep")
  assignedFactories Factory[]  @relation("FactorySalesRep")

  notes          Note[]
  accessRequest  AccessRequest?
  testRequestsCreated  TestRequest[] @relation("TestRequestRequester")
  testRequestsApproved TestRequest[] @relation("TestRequestApprover")
  notifications Notification[] @relation("UserNotifications")
  crmTasksOwned   CrmTask[] @relation("OwnedCrmTasks")
  crmTasksCreated CrmTask[] @relation("CreatedCrmTasks")
  auditLogs AuditLog[] @relation("UserAuditLogs")
  passwordResets PasswordResetToken[] @relation("PasswordResets")
  organizedMeetings Meeting[] @relation("MeetingOrganizer")
  complianceUploads ComplianceDocument[]
  sampleTrials     SampleTrialRequest[] @relation("TrialRequester")
  fuzeOrders       FuzeOrder[]          @relation("OrderUser")
  managedOrders    FuzeOrder[]          @relation("OrderAccountManager")
  outreachChecks   ContactOutreach[]    @relation("UserOutreach")
  entityManagers   EntityManager[]      @relation("UserEntityManagers")
  feedbackReports  FeedbackReport[]     @relation("FeedbackSubmitter")

  // Weekly Exec Review (gated dashboard — see WeeklyExecReport)
  ownedWeeklyReports   WeeklyExecReport[]      @relation("WeeklyReportOwner")
  grantedReportShares  WeeklyExecReportShare[] @relation("WeeklyShareGrantor")
  receivedReportShares WeeklyExecReportShare[] @relation("WeeklyShareRecipient")

  // BD Wizard Phase 3 — sequences this rep owns. A sequence is a multi-step
  // outbound run against (brand, contact, rep). Inverse of BDSequence.rep.
  bdSequences          BDSequence[]            @relation("UserBDSequences")

  // Saved email templates owned by this user (ticket #24). Includes PRIVATE
  // and SHARED ones they authored. GLOBAL templates have ownerId=null and
  // therefore don't appear in this collection.
  emailTemplates       EmailTemplate[]         @relation("EmailTemplateOwner")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([role])
  @@index([email])
}

// ─────────────────────────────────────────────
// BRANDS / CUSTOMERS
// ─────────────────────────────────────────────

model Brand {
  id     String @id @default(cuid())
  name   String @unique
  knackId String? @unique
  // HubSpot migration — stamped on import so re-runs of the importer
  // update existing rows instead of creating duplicates. Distinct from
  // knackId (legacy Knack-app import). Both can coexist on the same
  // brand if the same company existed in both systems.
  hubspotId String? @unique
  hubspotImportedAt DateTime?

  pipelineStage      PipelineStage @default(LEAD)
  customerType       String?
  leadReferralSource String?
  dateOfInitialContact DateTime?

  website        String?
  linkedInProfile String?
  backgroundInfo String?
  researchData   Json?
  researchDate   DateTime?

  projectType        String?
  projectDescription String?
  presentationDate   DateTime?
  forecast           String?
  deliverables       String?

  raw Json?

  // Validation fields (Phase 1 brand audit)
  validationStatus  String?   // verified | irrelevant | dead | duplicate | pending | unknown
  validationReason  String?   // AI-generated explanation for the classification
  validationDate    DateTime? // When last validated
  fuzeRelevance     String?   // high | medium | low | none — can we sell FUZE to them?
  textileCategory   String?   // What they actually make: apparel, home textiles, workwear, etc.
  companyStatus     String?   // active | closed | acquired | unknown
  validationData    Json?     // Full AI response + web research results

  salesRepId String?
  salesRep   User?  @relation("BrandSalesRep", fields: [salesRepId], references: [id])

  // BD Wizard concurrency lock — soft reservation with 30-min TTL so two
  // reps can't start the wizard on the same brand at the same second. The
  // permanent claim still lives on salesRepId (stamped on first send); this
  // is just a pick-time hold. See migration
  // 20260424000000_brand_wizard_reservation — Andrew 2026-04-23 (#101).
  reservedBy    String?
  reservedUntil DateTime?

  // BD Portal — last time ANY activity touched this brand (note/call/email/meeting).
  // Drives the 90-day inactivity auto-release job. Stamped in application code
  // whenever a Note, Meeting, or CRM email is written against this brand.
  lastActivityAt DateTime?

  // BD Portal — set to true when brand moves past PRESENTATION stage. Flags the
  // handoff queue for Andrew / Scott / Tina without forcing the rep to release.
  handoffPending Boolean @default(false)

  // BD Portal — stamped by the 75-day inactivity warn. Prevents the nightly
  // cron from re-warning the same rep; cleared on release or re-activity.
  inactivityWarnedAt DateTime?

  // BD Wizard Phase 3 — flipped true by the sequence engine when the brand
  // hits the "paid retargeting" step (Day 14 of the default cadence). We
  // don't push to an ad platform yet; the flag is the integration seam for
  // a future LinkedIn Matched Audiences / Meta Custom Audiences sync. For
  // now it just shows up as a column in the sequences dashboard so the
  // marketing operator knows which brands to bundle into the next ads run.
  paidAudienceTagged   Boolean   @default(false)
  paidAudienceTaggedAt DateTime?

  contacts    Contact[]
  bdSequences BDSequence[]  @relation("BrandBDSequences")
  factories   BrandFactory[]
  submissions FabricSubmission[]
  fabrics     Fabric[]
  projects    Project[]
  products    Product[]
  sows        SOW[]
  invoices    Invoice[]
  notes       Note[]
  users       User[]         @relation("BrandUsers")
  testRequests TestRequest[] @relation("TestRequestBrand")
  sampleTrials SampleTrialRequest[] @relation("TrialBrand")
  fuzeConsumptions FuzeConsumption[] @relation("ConsumptionBrand")
  fuzeOrders       FuzeOrder[]      @relation("OrderBrand")
  orderAllocations OrderBrandAllocation[] @relation("BrandOrderAllocations")
  meetings     Meeting[]      @relation("MeetingBrand")
  crmTasks     CrmTask[]      @relation("BrandCrmTasks")
  sourceRecords SourceRecord[]
  engagement BrandEngagement? @relation("BrandEngagement")

  // Brand-stipulated FUZE specification (KUIU promise May 2026 — Andrew
  // → Joseph: "you stipulate in the setup ... ongoing ICP testing at
  // intervals of production batches"). All optional; brands are added
  // to the pipeline long before they have a stipulated spec.
  //
  // requiredFuzeTier — F1/F2/F3/F4. The order-application validator
  //   in src/lib/order-validation.ts uses this to flag tier mismatches
  //   when factories under this brand order off-spec.
  //
  // icpCadenceEveryNBatches — "test ICP every N production batches".
  //   The cadence cron walks ProductionBatch rows for each factory in
  //   this brand's supply chain and flags overdue ICP submissions.
  //
  // icpCadenceEveryLitersConsumed — alternative cadence: every X
  //   liters of cumulative FuzeConsumption per factory. Used when the
  //   brand cares more about volume throughput than batch count.
  //
  // protocolDocUrl — link to the brand's stipulated protocol PDF
  //   (the document Andrew references in the email: "we will have this
  //   document included with your profile so they can reference it").
  requiredFuzeTier              String?
  icpCadenceEveryNBatches       Int?
  icpCadenceEveryLitersConsumed Float?
  protocolDocUrl                String?
  brandSpecUpdatedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pipelineStage])
  @@index([name])
  @@index([salesRepId, lastActivityAt])
  @@index([handoffPending])
}

// ─────────────────────────────────────────────
// FACTORIES / TEXTILE MILLS
// ─────────────────────────────────────────────

model Factory {
  id      String @id @default(cuid())
  name    String
  knackId String? @unique
  // HubSpot migration — stamped on import so contacts whose
  // "Associated Company IDs (Primary)" maps to a HubSpot company
  // that's a Factory in Atlas can resolve via this id rather than
  // landing as orphans. Same pattern as Brand.hubspotId.
  hubspotId String? @unique
  hubspotImportedAt DateTime?

  chineseName  String?
  millType     String?
  specialty    String?
  purchasing   String?
  annualSales  String?

  address          String?
  city             String?
  state            String?
  country          String?
  secondaryCountry String?

  development          String?
  presentationComplete Boolean?
  customerType         String?
  brandNominated       String?

  // ─── Searchable / Discovery Fields ─────────────
  productTypes      String?   // JSON array: ["activewear","denim","intimates","socks","wovens","knits","outerwear","home_textiles","non_woven","medical","industrial"]
  capabilities      String?   // JSON array: ["dyeing","finishing","printing","knitting","weaving","cut_sew","coating","laminating","embroidery","laser_cutting","digital_printing"]
  certifications    String?   // JSON array: ["oeko_tex_100","bluesign","gots","grs","iso_9001","iso_14001","wrap","bsci","sedex","higg"]
  fabricTypes       String?   // JSON array: ["jersey","interlock","pique","fleece","terry","mesh","rib","twill","poplin","satin","denim","nylon","polyester","cotton","blends","recycled"]
  moqMeters         Int?      // Minimum order quantity in meters
  leadTimeDays      Int?      // Typical lead time in days
  capacityMtMonth   Int?      // Monthly capacity in metric tons
  yearEstablished   Int?      // Year factory was established
  employeeCount     Int?      // Approximate headcount
  fuzeEnabled       Boolean?  // Has active FUZE treatment capability
  fuzeApplications  String?   // JSON array: ["bath_exhaust","spray_finish","jeanologia","wash_cycle","yarn_dye"]
  website           String?
  description       String?   // Free-text about the factory, searchable
  profileComplete   Boolean   @default(false)  // Whether discovery profile is filled out

  raw Json?

  // ─── Supply Chain: Default Distributor ─────────────
  distributorId String?
  distributor   Distributor? @relation("FactoryDistributor", fields: [distributorId], references: [id])

  // Which of the distributor's pricing tiers (1..5) this factory sits in.
  // Null = use the distributor's default pricing row. Set when the
  // distributor configures their tier table and assigns the factory.
  // Tier semantics are intentionally generic ("Tier 1..5") so each
  // distributor can name them per their own commercial logic
  // (geography / shipping cost / tariffs / end-use margin).
  distributorTierIndex Int?

  salesRepId String?
  salesRep   User?  @relation("FactorySalesRep", fields: [salesRepId], references: [id])

  contacts      Contact[]
  brands        BrandFactory[]
  submissions   FabricSubmission[]
  fabrics       Fabric[]
  fuzeTestRequests FuzeTestRequest[] @relation("FuzeTestFactory")
  projects      Project[]      @relation("ProjectFactory")
  invoices      Invoice[]
  users         User[]         @relation("FactoryUsers")
  sourceRecords SourceRecord[]
  accessRequests AccessRequest[] @relation("AccessRequestFactory")
  sampleTrials   SampleTrialRequest[] @relation("FactoryTrials")
  distributorDocs DistributorDocument[] @relation("DistributorDocFactory")
  fuzeOrders      FuzeOrder[]          @relation("FactoryOrders")
  fuzeConsumptions FuzeConsumption[]   @relation("FactoryConsumption")
  distributorPricing DistributorPricing[] @relation("FactoryDistributorPricing")
  notes           Note[]               @relation("FactoryNotes")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([country])
  @@index([profileComplete])
  @@index([distributorId])
}

model BrandFactory {
  id        String  @id @default(cuid())
  brandId   String
  factoryId String
  brand     Brand   @relation(fields: [brandId], references: [id])
  factory   Factory @relation(fields: [factoryId], references: [id])

  isPrimary Boolean @default(false)
  note      String?

  createdAt DateTime @default(now())

  @@unique([brandId, factoryId])
  @@index([brandId])
  @@index([factoryId])
}

// ─────────────────────────────────────────────
// DISTRIBUTORS
// ─────────────────────────────────────────────

model Distributor {
  id      String @id @default(cuid())
  name    String
  knackId String? @unique
  // HubSpot migration — same pattern as Brand.hubspotId and
  // Factory.hubspotId. Lets contacts whose company maps to an
  // Atlas distributor resolve to the right entity instead of
  // becoming an orphan or creating a duplicate Brand.
  hubspotId String? @unique
  hubspotImportedAt DateTime?

  chineseName  String?
  specialty    String?
  agentForFuze String?
  annualSales  String?

  // Location
  country      String?
  region       String?   // "South Asia", "Middle East", "East Asia", "Europe", "Latin America", etc.
  city         String?
  address      String?

  // Contact
  email        String?
  phone        String?
  website      String?

  // Status
  status       String   @default("ACTIVE")  // ACTIVE, INACTIVE, ONBOARDING
  active       Boolean  @default(true)

  // Coverage — countries this distributor serves
  coverageCountries String?  // JSON array: ["India","Bangladesh","Sri Lanka"]
  localCurrency     String?  // Primary local currency code: INR, AED, EUR, TWD, CNY, etc.

  notes        String?

  raw Json?

  contacts      Contact[]
  factories     Factory[]      @relation("FactoryDistributor")
  projects      Project[]      @relation("ProjectDistributor")
  invoices      Invoice[]
  documents     DistributorDocument[]
  users         User[]         @relation("DistributorUsers")
  sourceRecords SourceRecord[]
  fuzeOrders    FuzeOrder[]    @relation("OrderDistributor")
  testRequests  TestRequest[]  @relation("TestRequestDistributor")
  // Distributor-owned fabric portfolio — fabrics they're testing
  // independently or in co-op programs.
  fabrics       Fabric[]       @relation("FabricDistributor")
  pricing       DistributorPricing[] @relation("DistributorPricing")
  inventory     DistributorInventory? @relation("DistributorInventory")
  restockOrders DistributorRestockOrder[] @relation("DistributorRestockOrders")
  // Restock orders this distributor receives from sub-distributors —
  // i.e. the inverse of `restockOrders`, fired when a sub-distributor
  // places an order against this (master) distributor instead of FUZE.
  incomingSubOrders DistributorRestockOrder[] @relation("MasterIncomingRestocks")

  // ─── Master / Sub Distributor hierarchy ─────────────────────
  // Tandy's planned China import entity is a "master" — imports from
  // FUZE in bulk, holds central inventory, sells onward to local
  // sub-distributors (Texwell, Hi-Goal). The relationship is a simple
  // self-relation: parentDistributorId NULL = master or standalone;
  // parentDistributorId SET = sub of that distributor.
  //
  // Pricing chain becomes:
  //   FUZE → Master  (uses Distributor.fuzeRestockPricePerLiter)
  //   Master → Sub   (uses Distributor.subDistributorPricePerLiter on master)
  //   Sub   → Factory (uses Master/Sub's DistributorPricing tier table)
  //
  // Sub-distributor restocks target the master, not FUZE — see
  // DistributorRestockOrder.targetDistributorId.
  parentDistributorId String?
  parentDistributor   Distributor?  @relation("DistributorHierarchy", fields: [parentDistributorId], references: [id])
  subDistributors     Distributor[] @relation("DistributorHierarchy")

  // Master → Sub wholesale pricing (only meaningful when this dist
  // acts as a master and has children).
  subDistributorPricePerLiter Float?
  subDistributorCurrency      String?  // Master's currency to sub (often local — e.g. RMB for Tandy's China master)
  subDistributorNotes         String?

  // FUZE → Distributor pricing (what FUZE charges this distributor for restock)
  fuzeRestockPricePerLiter Float?   // USD/L that FUZE charges this distributor
  fuzeRestockCurrency      String?  @default("USD")
  fuzeRestockNotes         String?  // Admin notes on pricing terms

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentDistributorId])
}

// ─────────────────────────────────────────────
// DISTRIBUTOR RESTOCK ORDERS
// Distributors ordering FUZE product FROM FUZE HQ
// Units: CARBOY (19L), GAYLORD (32 carboys / 608L),
// CONTAINER_20 (10 gaylords / 6,080L), CONTAINER_40 (20 gaylords / 12,160L)
// ─────────────────────────────────────────────
model DistributorRestockOrder {
  id              String   @id @default(cuid())
  orderNumber     String   @unique  // FUZE-RST-YYYYMMDD-XXXX

  distributorId   String
  distributor     Distributor @relation("DistributorRestockOrders", fields: [distributorId], references: [id])

  // Where the restock order is sourced FROM. Null = ordered direct
  // from FUZE HQ (the original behavior, still the default for master
  // and standalone distributors). Set = ordered from a parent master
  // distributor (sub-distributor restock flow). The parent then
  // fulfills from their own warehouse and burns down their inventory.
  // FUZE never sees the master→sub transaction directly.
  targetDistributorId String?
  targetDistributor   Distributor? @relation("MasterIncomingRestocks", fields: [targetDistributorId], references: [id])

  orderedById     String?  // User who placed the order
  // What was ordered
  unitType        String   // CARBOY | GAYLORD | CONTAINER_20 | CONTAINER_40
  unitQuantity    Int      // Number of those units
  totalLiters     Float    // Computed total liters

  // Quote / pricing
  pricePerLiter   Float
  currency        String   @default("USD")
  totalPrice      Float
  quoteAcceptedAt DateTime?

  // Shipping
  shippingAddress String?
  shippingCity    String?
  shippingCountry String?
  trackingNumber  String?
  carrier         String?
  shippedDate     DateTime?
  estimatedDelivery DateTime?
  deliveredDate   DateTime?
  receivedConfirmedAt DateTime?  // Distributor confirms receipt

  // Status workflow:
  // DRAFT → PENDING_APPROVAL → APPROVED → PROCESSING → SHIPPED → DELIVERED → RECEIVED → CANCELLED
  status          String   @default("PENDING_APPROVAL")

  approvedAt      DateTime?
  approvedById    String?

  notes           String?
  adminNotes      String?

  // Sample / FOC handling — Tina Distributor #cmo9jdb1a request.
  // orderCategory: PRODUCTION | SAMPLE | HANGTAG. Defaults to
  // PRODUCTION (existing behavior) so legacy orders stay correctly
  // categorized. SAMPLE category unlocks the 1L / 0.5L bottle sizes
  // (which would otherwise fail the international-Gaylord-minimum
  // gate). isFOC = "free of charge" — distributor + admin both see
  // the line item but the totalPrice on FOC orders is forced to 0.
  orderCategory   String?  @default("PRODUCTION")
  isFOC           Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([distributorId])
  @@index([status])
  @@index([createdAt])
  @@index([targetDistributorId])
}

// ─────────────────────────────────────────────
// LABS
// ─────────────────────────────────────────────

model Lab {
  id      String @id @default(cuid())
  name    String @unique
  knackId String? @unique

  // Location
  address   String?
  city      String?
  state     String?
  country   String?
  region    String?   // "Asia Pacific", "North America", "Europe", etc.

  // Contact
  website   String?
  email     String?
  phone     String?

  // Capabilities & Certifications
  accreditations String?  // "ISO 17025, TAF, CNAS" etc.
  capabilities   String?  // Comma-separated: "ICP,ANTIBACTERIAL,FUNGAL,ODOR,UV"
  icpApproved    Boolean @default(false)
  abApproved     Boolean @default(false)
  fungalApproved Boolean @default(false)
  odorApproved   Boolean @default(false)
  uvApproved     Boolean @default(false)

  // Notes
  notes     String?
  active    Boolean @default(true)

  raw Json?

  // Customer account number at this lab
  customerNumber String?

  users         User[]       @relation("LabUsers")
  testRuns      TestRun[]
  testRequests  TestRequest[]
  sourceRecords SourceRecord[]
  services      LabService[]
  documents     Document[]
  shipments SampleShipment[] @relation("LabShipments")
  sampleTrials SampleTrialRequest[] @relation("TrialIcpLab")
  fuzeTestRequests FuzeTestRequest[] @relation("FuzeTestLab")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([country])
  @@index([icpApproved])
}

// ─────────────────────────────────────────────
// LAB SERVICES & PRICING
// ─────────────────────────────────────────────

model LabService {
  id    String @id @default(cuid())
  labId String
  lab   Lab    @relation(fields: [labId], references: [id], onDelete: Cascade)

  testType      String   // "ICP", "ANTIBACTERIAL", "FUNGAL", "ODOR", "UV", "MICROFIBER", etc.
  testMethod    String?  // "AATCC 100", "ASTM E2149", "JIS L 1902", "ICP-OES", etc.
  description   String?  // e.g. "Antibacterial - AATCC 100 (S. aureus + K. pneumoniae)"
  priceUSD      Float?   // Our negotiated price per test
  listPriceUSD  Float?   // Lab's list price (before discount)
  turnaroundDays Int?    // Standard turnaround in business days
  rushPriceUSD  Float?   // Rush/expedited price
  rushDays      Int?     // Rush turnaround days
  preferred     Boolean  @default(false) // FUZE-recommended lab for this specific test
  preferredNote String?  // e.g. "Best price", "Fastest turnaround", "Best accuracy"
  notes         String?  // Special conditions, minimum qty, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([labId, testType, testMethod])
  @@index([labId])
}

model TestCatalogItem {
  id              String  @id @default(cuid())
  testKey         String  @unique  // "recipe-build", "antibacterial-screen", etc.
  name            String
  description     String?
  category        String  @default("performance") // recipe_build, performance, quality, certification
  moqMeters       Float   @default(1)
  controlRequired Boolean @default(false)
  controlNote     String?
  turnaroundDays  Int     @default(7)
  estimatedCostUsd Float?
  methods         String[] // test methods included
  active          Boolean @default(true)
  sortOrder       Int     @default(0)

  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active])
}

// ─────────────────────────────────────────────
// CONTACTS
// ─────────────────────────────────────────────

model Contact {
  id String @id @default(cuid())

  title      String?
  firstName  String?
  middleName String?
  lastName   String?
  name       String?

  email   String?
  phone   String?
  address String?

  // Enrichment fields
  personalEmail    String?
  linkedinUrl      String?
  jobTitle         String?   // VP Supply Chain, Director Sourcing, etc.
  seniority        String?   // vp, director, c_suite, manager
  emailStatus      String?   // verified, unavailable, extrapolated
  enrichedAt       DateTime?
  enrichmentSource String?   // apollo, manual, research, hubspot_migration
  apolloId         String?   // Apollo person ID for re-enrichment
  // HubSpot migration — stamped on import so re-runs of the importer
  // update existing rows instead of creating duplicates. Falls through
  // to email match for contacts that existed in Atlas before the
  // HubSpot pull.
  hubspotId        String?  @unique
  hubspotImportedAt DateTime?

  // Outreach tracking
  outreachStatus   String?   @default("not_contacted") // not_contacted, contacted, responded, meeting_booked, not_interested
  lastContactedAt  DateTime?
  lastResponseAt   DateTime?
  outreachCount    Int       @default(0)

  // Categorization
  vertical         String?   // apparel, hospitality, workwear, home_textiles
  decisionMaker    Boolean   @default(false)
  companyRevenue   String?

  // ─ Hygiene / placeholder-detection ──────────────────────────────
  // Populated by /api/admin/contact-hygiene/scan (admin sweep) or
  // whenever a rep opens a brand in the BD Wizard. Snapshots the
  // result of assessContact() from src/lib/contact-quality.ts so the
  // UI doesn't have to recompute on every render and the flag
  // survives across refreshes.
  hygieneScore     Int?       // 0-100, higher = more likely real
  hygieneVerdict   String?    // real | suspicious | placeholder | role_account
  hygieneFlags     String?    // JSON array of reasons (stringified)
  hygieneCheckedAt DateTime?  // when the hygiene pass last ran
  emailValidity    String?    // valid | invalid | risky | unknown (format-only)
  linkedinValidity String?    // valid | invalid | unknown (shape-only)
  hiddenFromWizard Boolean    @default(false) // reversible — admin can unflag

  brandId       String?
  factoryId     String?
  distributorId String?

  brand       Brand?       @relation(fields: [brandId], references: [id])
  factory     Factory?     @relation(fields: [factoryId], references: [id])
  distributor Distributor? @relation(fields: [distributorId], references: [id])

  outreachMessages OutreachMessage[]
  outreachChecks   ContactOutreach[]
  bdSequences      BDSequence[]      @relation("ContactBDSequences")
  notes            Note[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([factoryId])
  @@index([outreachStatus])
  @@index([emailStatus])
  @@index([vertical])
  @@index([hiddenFromWizard])
  @@index([hygieneVerdict])
}

// ─────────────────────────────────────────────
// CONTACT OUTREACH TRACKING (per-user checkmarks)
// ─────────────────────────────────────────────

model ContactOutreach {
  id String @id @default(cuid())

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation("UserOutreach", fields: [userId], references: [id])

  type String // LINKEDIN, EMAIL

  sentAt    DateTime @default(now())
  notes     String?  // optional note about the outreach

  createdAt DateTime @default(now())

  @@unique([contactId, userId, type]) // one checkmark per user per type per contact
  @@index([contactId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// OUTREACH MESSAGES (SMS + Email tracking)
// ─────────────────────────────────────────────

model OutreachMessage {
  id String @id @default(cuid())

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  channel     String   // sms, email
  template    String?  // intro, sustainability, competitive, sample_offer, followup
  subject     String?  // email subject line
  body        String   // full message body sent
  toAddress   String   // phone number or email address used

  status      String   @default("sent") // sent, delivered, failed, bounced, replied
  sentAt      DateTime @default(now())
  deliveredAt DateTime?
  failReason  String?

  // Twilio/Resend tracking
  externalId  String?  // Twilio SID or Resend message ID
  sentBy      String?  // user ID or "system"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([channel])
  @@index([sentAt])
}

// ─────────────────────────────────────────────
// FABRICS
// ─────────────────────────────────────────────

model Fabric {
  id String @id @default(cuid())

  fuzeNumber   Int?    @unique
  customerCode String?
  factoryCode  String?

  // Customer-facing reference — whatever the customer calls this sample on
  // THEIR side (e.g. "Penfabric Test #2503", "Rhone style ATGG400",
  // "H&M dev code W-2487"). Free-text, displayed prominently on any
  // externally-shared report so the recipient immediately recognizes the
  // submission. Distinct from customerCode (brand SKU) and factoryCode
  // (factory SKU) — this is specifically the identifier the customer used
  // when they sent us the fabric / asked for the test.
  customerReference String?

  construction String?
  color        String?
  weightGsm    Float?
  widthInches  Float?
  yarnType     String?
  finishNote   String?
  note         String?

  brandId   String?
  factoryId String?
  // Distributor-owned fabrics — for fabrics a distributor is testing
  // independently or as part of a co-op program (multi-brand /
  // multi-factory pilots they sponsor). Distinct from factoryId
  // (the manufacturer the fabric came from) and brandId (the brand
  // marketing it). A distributor-owned fabric in their portfolio
  // can have NO factoryId / brandId yet — they're developing it
  // before assigning to anyone.
  distributorId String?
  brand     Brand?       @relation(fields: [brandId], references: [id])
  factory   Factory?     @relation(fields: [factoryId], references: [id])
  distributor Distributor? @relation("FabricDistributor", fields: [distributorId], references: [id])

  raw Json?

  // Expanded fields (v2 intake form)
  endUse           String?    // Product type: t-shirt, athletic, bedding, etc.
  targetFuzeTier   String?    // F1, F2, F3, F4
  annualVolume     String?    // Estimated annual volume
  quantityType     String?    // ACTUAL, FORECAST, DEVELOPMENT, RD
  quantityUnit     String?    // meters, yards, kg
  batchLotNumber   String?    // Manufacturer batch/lot
  thickness        Float?     // mm
  shrinkageLength  Float?     // % shrinkage length
  shrinkageWidth   Float?     // % shrinkage width
  fabricCategory   String?    // woven, knit, nonwoven
  knitStitchType   String?    // jersey, rib, interlock, etc.
  weavePattern     String?    // plain, twill, satin, etc.
  gauge            String?    // knit gauge
  threadCountWarp  Int?
  threadCountWeft  Int?

  // Pretreatment
  pretreatment     Json?      // Full pretreatment data as JSON
  fabricPh         Float?     // pH after pretreatment

  // Dyeing
  dyeApplied       Boolean?
  dyeStage         String?    // yarn-dyed, piece-dyed, garment-dyed, greige
  dyeClass         String?    // reactive, disperse, acid, vat, etc.
  dyeDetails       Json?      // Full dye chemistry as JSON

  // Chemical finishes
  finishSoftener   Json?      // Softener details (type, ionic charge, concentration, etc.)
  finishRepellent  Json?      // Water repellent details
  finishWicking    Json?      // Moisture management details
  finishWrinkleFree Json?     // Easy-care finish details
  finishOther      Json?      // Other finishes (flame retardant, UV, anti-static, etc.)

  // Intake metadata
  intakeFormId     String?    // Reference to uploaded intake form
  intakeParsedAt   DateTime?  // When the intake form was parsed

  // Lab lifecycle
  // UPLOADED → RECEIVED → TESTING → COMPLETE (→ ARCHIVED)
  labStatus                   String?   @default("UPLOADED")
  receivedAt                  DateTime?
  receivedById                String?
  testingStartedAt            DateTime?
  testingStartedById          String?
  testingEstimatedCompletion  DateTime?
  testingCompletedAt          DateTime?
  testingCompletedById        String?
  labNotes                    String?

  contents    FabricContent[]
  submissions FabricSubmission[]
  testRequests TestRequest[]
  fuzeTestRequests FuzeTestRequest[] @relation("FuzeTestFabric")
  sampleTrials     SampleTrialRequest[] @relation("FabricTrials")
  fuzeConsumptions FuzeConsumption[] @relation("ConsumptionFabric")
  fuzeOrders       FuzeOrder[]      @relation("OrderFabric")
  recipeBenchTests RecipeBenchTest[] @relation("FabricRecipeBenchTests")
  solarisTests     SolarisTest[]     @relation("FabricSolarisTests")
  sampleApplications SampleApplication[] @relation("FabricSampleApplications")
  shipments SampleShipment[] @relation("FabricShipments")
  reportShares     FabricReportShare[] @relation("FabricReportShares")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fuzeNumber])
  @@index([customerCode])
  @@index([factoryCode])
  @@index([brandId])
  @@index([factoryId])
  @@index([distributorId])
}

model FabricContent {
  id       String @id @default(cuid())
  fabricId String
  fabric   Fabric @relation(fields: [fabricId], references: [id])

  material      String
  percent       Float?
  rawText       String?

  @@index([fabricId])
  @@index([material])
}

// ─────────────────────────────────────────────
// MATERIAL NORMALIZATION
// ─────────────────────────────────────────────

model MaterialAlias {
  id            String @id @default(cuid())
  alias         String @unique
  canonicalName String

  @@index([canonicalName])
}

// ─────────────────────────────────────────────
// FABRIC SUBMISSIONS (fabric + treatment context)
// ─────────────────────────────────────────────

model FabricSubmission {
  id String @id @default(cuid())

  brandId   String?
  factoryId String?
  fabricId  String?

  brand   Brand?   @relation(fields: [brandId], references: [id])
  factory Factory? @relation(fields: [factoryId], references: [id])
  fabric  Fabric?  @relation(fields: [fabricId], references: [id])

  fuzeFabricNumber   Int?
  customerFabricCode String?
  factoryFabricCode  String?

  applicationMethod    String?
  applicationRecipeRaw String?
  padRecipeRaw         String?
  treatmentLocation    String?
  applicationDate      DateTime?

  washTarget Int?

  status           String?
  programName      String?
  developmentStage String?
  testStatus       String?
  category         String?

  icpSent     Boolean?
  icpReceived Boolean?
  icpPassed   Boolean?

  abSent      Boolean?
  abReceived  Boolean?
  abPassed    Boolean?

  progressPercent Float?

  raw Json?

  testRuns      TestRun[]
  testRequests  TestRequest[]
  documents     Document[]
  sourceRecords SourceRecord[]
  shipments SampleShipment[] @relation("SubmissionShipments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fuzeFabricNumber])
  @@index([customerFabricCode])
  @@index([factoryFabricCode])
  @@index([status])
  @@index([testStatus])
}

// ─────────────────────────────────────────────
// PROJECTS (grouping tests under a brand)
// ─────────────────────────────────────────────

model Project {
  id      String @id @default(cuid())
  name    String
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  description String?

  // ─── Commercial Pipeline Fields ─────────────
  stage              String    @default("DEVELOPMENT")  // DEVELOPMENT, SAMPLING, TESTING, APPROVED, COMMERCIALIZATION, PRODUCTION, COMPLETE
  projectedValue     Float?    // Projected annual revenue (USD or currency)
  actualValue        Float?    // Realized revenue from invoices
  currency           String    @default("USD")
  probability        Int       @default(50)             // Win probability 0-100
  fuzeTier           String?   // F1, F2, F3, F4
  annualVolumeMeters Float?    // Projected annual production volume in meters
  annualFuzeLiters   Float?    // Calculated: FUZE liters needed per year

  // ─── Manufacturing Assignment ─────────────
  factoryId     String?
  factory       Factory?     @relation("ProjectFactory", fields: [factoryId], references: [id])
  distributorId String?
  distributor   Distributor? @relation("ProjectDistributor", fields: [distributorId], references: [id])

  // ─── Timeline ─────────────
  expectedProductionDate DateTime?
  actualProductionDate   DateTime?

  testRuns     TestRun[]
  testRequests TestRequest[]
  invoices     Invoice[]
  meetings     Meeting[] @relation("MeetingProject")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, brandId])
  @@index([brandId])
  @@index([name])
  @@index([stage])
  @@index([factoryId])
  @@index([distributorId])
}

// ─────────────────────────────────────────────
// PRODUCTS / SKUs
// ─────────────────────────────────────────────

model Product {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  name        String
  productType String?
  sku         String?
  description String?

  sows SOWProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, name])
  @@index([brandId])
  @@index([sku])
}

model SOWProduct {
  id        String  @id @default(cuid())
  sowId     String
  productId String
  sow       SOW     @relation(fields: [sowId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  note String?

  createdAt DateTime @default(now())

  @@unique([sowId, productId])
  @@index([sowId])
  @@index([productId])
}

// ─────────────────────────────────────────────
// TEST RUNS & RESULTS
// ─────────────────────────────────────────────

model TestRun {
  id String @id @default(cuid())

  submissionId String?
  labId        String?
  projectId    String?

  submission FabricSubmission? @relation(fields: [submissionId], references: [id])
  lab        Lab?              @relation(fields: [labId], references: [id])
  project    Project?          @relation(fields: [projectId], references: [id])

  testNumber       Int?
  testType         TestType
  testMethodRaw    String?
  testMethodStd    String?
  testReportNumber String?
  fuzeInternalReportNumber String?
  postWashReportNumber     String?

  testDate     DateTime?
  postWashDate DateTime?

  washCount    Int?
  washLabelRaw String?

  machineType String?
  testedMetal String?

  agSerialNumber     String?
  auSerialNumber     String?
  fungalSerialNumber String?

  raw Json?

  // Multi-test PDF support
  testNumberInReport Int?      // Which test in a multi-test report (1, 2, ...)

  // AI review
  aiReviewData  Json?          // Merged anomaly review from dual-AI
  aiReviewDate  DateTime?
  aiReviewNotes String?        // Human-editable notes from AI flags

  // Brand visibility: only "stamped" tests visible to brand users
  brandVisible      Boolean  @default(false)
  brandApprovedById String?
  brandApprovedAt   DateTime?

  icpResult    IcpResult?
  abResult     AntibacterialResult?
  fungalResult FungalResult?
  odorResult   OdorResult?

  documents     Document[]
  sourceRecords SourceRecord[]
  testRequestLines TestRequestLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([testType])
  @@index([testMethodStd])
  @@index([washCount])
  @@index([testDate])
  @@index([submissionId])
  @@index([projectId])
}

model IcpResult {
  id        String  @id @default(cuid())
  testRunId String  @unique
  testRun   TestRun @relation(fields: [testRunId], references: [id])

  agValue Float?
  auValue Float?

  agRaw String?
  auRaw String?
  unit  String?
}

model AntibacterialResult {
  id        String  @id @default(cuid())
  testRunId String  @unique
  testRun   TestRun @relation(fields: [testRunId], references: [id])

  // Legacy fields (kept for backward compat with CSV imports)
  organism1    String?
  organism2    String?
  result1      Float?
  result2      Float?
  organism1Raw String?
  organism2Raw String?
  result1Raw   String?
  result2Raw   String?
  pass         Boolean?

  // ── Rich fields for ITS-style reports ──────────────────
  organism        String?   // "Staphylococcus aureus" or "Escherichia coli"
  strainNumber    String?   // "ATCC 6538" or "ATCC 25922"
  testMethodStd   String?   // "AATCC TM100-2019", "JIS L 1902:2015", "ASTM E2149-20"
  brothMedia      String?   // "Cation Adjusted Mueller Hinton Broth"
  surfactant      String?   // "0.05% Triton X-100"
  sterilization   String?   // "UV Sterilization" / "No Sterilization"
  contactTime     String?   // "24 Hours"
  incubationTemp  String?   // "37±2°C" / "35±2°C"
  agarMedium      String?   // "Nutrient Agar" / "Plate Count Agar"

  // Numeric results (method-dependent)
  inoculumCFU      Float?   // Starting inoculum concentration (CFU/mL)
  controlCFU       Float?   // Control bacteria after incubation
  treatedCFU       Float?   // Treated bacteria after incubation
  percentReduction Float?   // For AATCC TM100 & ASTM E2149
  growthValue      Float?   // F value (log growth)
  activityValue    Float?   // JIS L 1902 "A" value

  // Method-specific pass/fail
  methodPass       Boolean? // Per method thresholds
  methodPassReason String?  // "A=-0.2, requires A>=2.0 for Effect"

  // All extracted data as JSON (preserves everything the parser found)
  rawExtracted     Json?
}

model FungalResult {
  id        String  @id @default(cuid())
  testRunId String  @unique
  testRun   TestRun @relation(fields: [testRunId], references: [id])

  writtenResult String?
  pass          Boolean?
  raw           String?
}

model OdorResult {
  id        String  @id @default(cuid())
  testRunId String  @unique
  testRun   TestRun @relation(fields: [testRunId], references: [id])

  testedOdor String?
  result     String?
  pass       Boolean?
}

// ─────────────────────────────────────────────
// SOW (Scope of Work)
// ─────────────────────────────────────────────

model SOW {
  id      String    @id @default(cuid())
  brandId String
  brand   Brand     @relation(fields: [brandId], references: [id])

  title               String?
  expectations        String?
  performanceCriteria String?
  pricingTerms        String?
  costControls        String?

  signatory      String?
  signatoryTitle String?
  signatoryEmail String?

  status SOWStatus @default(DRAFT)

  milestones     SOWMilestone[]
  products       SOWProduct[]
  documents      Document[]
  accessRequests AccessRequest[]
  testRequests   TestRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([status])
}

model SOWMilestone {
  id    String @id @default(cuid())
  sowId String
  sow   SOW    @relation(fields: [sowId], references: [id])

  title       String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  sortOrder   Int       @default(0)

  @@index([sowId])
}

// ─────────────────────────────────────────────
// DOCUMENTS / ATTACHMENTS
// ─────────────────────────────────────────────

model Document {
  id String @id @default(cuid())

  kind        DocKind @default(REPORT)
  filename    String?
  contentType String?
  sizeBytes   Int?

  bucket String?
  key    String? @unique
  url    String?

  submissionId String?
  testRunId    String?
  sowId        String?
  labId        String?

  submission FabricSubmission? @relation(fields: [submissionId], references: [id])
  testRun    TestRun?          @relation(fields: [testRunId], references: [id])
  sow        SOW?              @relation(fields: [sowId], references: [id])
  lab        Lab?              @relation(fields: [labId], references: [id])

  raw Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([submissionId])
  @@index([testRunId])
  @@index([sowId])
}

// ─────────────────────────────────────────────
// NOTES / ACTIVITY LOG
// ─────────────────────────────────────────────

model Note {
  id String @id @default(cuid())

  date     DateTime?
  content  String
  noteType String?

  brandId   String?
  brand     Brand?   @relation(fields: [brandId], references: [id])
  factoryId String?
  factory   Factory? @relation("FactoryNotes", fields: [factoryId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  contactName String?
  taskStatus  String?

  // ─── Email log fields (populated when noteType = "EMAIL") ─────
  emailDirection String?  // "INBOUND" | "OUTBOUND"
  emailSubject   String?
  emailFrom      String?
  emailTo        String?
  emailCc        String?
  emailMessageId String?  @unique

  // Optional link back to a Weekly Exec Review — when a note is captured
  // inline from the /admin/weekly-review dashboard, we stamp this FK so
  // the appendix can show exactly which notes were authored during review.
  // The note still lives on its brand/factory/contact normally.
  weeklyReportId String?
  weeklyReport   WeeklyExecReport? @relation(fields: [weeklyReportId], references: [id])

  createdAt DateTime @default(now())

  @@index([brandId])
  @@index([factoryId])
  @@index([contactId])
  @@index([date])
  @@index([weeklyReportId])
}

// ─────────────────────────────────────────────
// INVOICES / REVENUE TRACKING
// ─────────────────────────────────────────────

model Invoice {
  id String @id @default(cuid())

  invoiceNumber String
  invoiceDate   DateTime
  dueDate       DateTime?
  paidDate      DateTime?
  amount        Float
  currency      String   @default("USD")
  status        String   @default("DRAFT")  // DRAFT, SENT, PAID, OVERDUE, CANCELLED
  description   String?
  notes         String?

  // ─── Links ─────────────
  distributorId String
  distributor   Distributor @relation(fields: [distributorId], references: [id])
  factoryId     String
  factory       Factory     @relation(fields: [factoryId], references: [id])
  brandId       String?
  brand         Brand?      @relation(fields: [brandId], references: [id])
  projectId     String?
  project       Project?    @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([distributorId])
  @@index([factoryId])
  @@index([brandId])
  @@index([projectId])
  @@index([status])
  @@index([invoiceDate])
}

// ─────────────────────────────────────────────
// DISTRIBUTOR DOCUMENTS
// ─────────────────────────────────────────────

model DistributorDocument {
  id String @id @default(cuid())

  distributorId String
  distributor   Distributor @relation(fields: [distributorId], references: [id])

  // Document classification
  docType     DistDocType  @default(OTHER)
  title       String                // "Certificate of Analysis - Batch 2024-03"
  description String?

  // File info
  filename    String?
  contentType String?
  sizeBytes   Int?
  url         String?               // S3/R2 URL or external link
  bucket      String?
  key         String?    @unique

  // Optional links to related entities
  factoryId   String?
  factory     Factory?   @relation("DistributorDocFactory", fields: [factoryId], references: [id])
  invoiceId   String?

  // Shipping/logistics metadata
  shipmentRef   String?             // tracking number or shipment ID
  batchNumber   String?             // production batch reference
  poNumber      String?             // purchase order
  portOfOrigin  String?
  portOfDest    String?
  hsCode        String?             // harmonized system code

  uploadedBy  String?               // user ID who uploaded
  expiresAt   DateTime?             // for time-sensitive docs like C of A

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([distributorId])
  @@index([docType])
  @@index([factoryId])
  @@index([createdAt])
}

enum DistDocType {
  CERTIFICATE_OF_ANALYSIS   // C of A
  BILL_OF_LADING            // BOL
  COMMERCIAL_INVOICE
